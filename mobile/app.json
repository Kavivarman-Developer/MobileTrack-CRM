{
  "expo": {
    "name": "Kadai Kanakku",
    "slug": "mobile",
    "scheme": "mobiletrackcrm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kavivarman.mobile",
      "permissions": [
        "READ_CALL_LOG",
        "READ_PHONE_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "9be22024-ea4c-4892-846b-9828b89548b9"
      }
    },
    "plugins": [
      "expo-web-browser",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Kadai Kanakku to access the camera to scan product barcodes."
        }
      ]
    ]
  }
}
